# Configuracion LOCAL para los entrypoints de este repo (tests).
# Copiar a `.env` (ignorado por git) y ajustar. La libreria NO lee este
# archivo: solo recibe parametros explicitos. Cualquier proyecto que importe
# `db` usa su propio `.env` y pasa los valores a crear_engine_oracle /
# crear_engine_sqlserver.
#
# Uso: uv run --env-file .env python tests/test_conexion.py
#
# Los valores de ejemplo son placeholders: reemplazar con los reales.
# Si solo se quiere probar un motor, dejar vacio el bloque del otro.


# --- Oracle (requerido por la prueba de Oracle) ---
ORACLE_USUARIO=usuario
ORACLE_CLAVE=cambiar
ORACLE_HOST=servidor.local
ORACLE_SERVICIO=SERVICIO
# ORACLE_PUERTO=1521
# Ruta del Oracle Client de 64 bits, solo si se necesita modo thick.
# Ejemplo: ORACLE_RUTA_CLIENTE=C:/oracle/instantclient_21_10


# --- SQL Server (requerido por la prueba de SQL Server) ---
SQLSERVER_USUARIO=usuario
SQLSERVER_CLAVE=cambiar
SQLSERVER_HOST=servidor.local
SQLSERVER_BD=base_de_datos
# SQLSERVER_PUERTO=1433
# Bases antiguas que solo hablan TDS 7.0: descomentar.
# SQLSERVER_TDS=7.0


# --- Logging (opcional, default INFO) ---
# DB_NIVEL_LOG=DEBUG
